#include <iostream>
using namespace std;

int main() {
    int soto, rawon, total, bayar;

    cout << "Menu Makanan" << endl;
    cout << "Soto  : 15000" << endl;
    cout << "Rawon : 20000" << endl << endl;

    cout << "Porsi soto  : ";
    cin >> soto;
    cout << "Porsi rawon : ";
    cin >> rawon;

    total = (soto * 15000) + (rawon * 20000);
    cout << "Total       : " << total << endl;

    cout << "Bayar       : ";
    cin >> bayar;
    cout << "Kembali     : " << bayar - total << endl;

    return 0;
}
